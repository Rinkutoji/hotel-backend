APP_NAME="Hotel Management System V2"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL, matching the reference project's XAMPP setup - explicit
# requirement, not the genuine skeleton's sqlite default.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hotel_management_v2
DB_USERNAME=root
DB_PASSWORD=

# File-based session/cache and a sync queue - deliberately NOT the genuine
# skeleton's 'database' defaults. This is a stateless bearer-token API
# (Architecture Baseline §7) with no queued jobs yet, so there's no need
# to migrate the users/cache/jobs tables just to make these drivers work.
# See docs/STEP-02-IMPLEMENTATION-REPORT.md for the full reasoning.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- CORS (Architecture Baseline §14) ---
# Comma-separated list of exact frontend origins. Never '*'.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Booking business rules - read via config('booking.*'), never env() directly ---
# Architecture Baseline §9 - approved: 2 hours.
UNPAID_BOOKING_HOLD_HOURS=2
# Architecture Baseline §13 - approved: 15 minutes.
CLEANING_BUFFER_MINUTES=15
# STEP 09 - approved caps (docs/STEP-09-BOOKING-PLAN.md §10).
BOOKING_MAX_STAY_NIGHTS=30
BOOKING_MAX_ROOMS_PER_BOOKING=5
# STEP 15 - late-cancellation fee rules (docs/STEP-15-IMPLEMENTATION-PLAN.md §4/§5).
LATE_CANCEL_WINDOW_HOURS=24
LATE_CANCEL_FEE_NIGHTS=1

# --- Payments (STEP 10) ---
# Maximum receipt upload size in KB (docs/STEP-10-PAYMENT-PLAN.md §6).
PAYMENT_RECEIPT_MAX_KB=4096

# --- Sanctum ---
SANCTUM_EXPIRATION=10080
SANCTUM_TOKEN_PREFIX=
